terEvents=1;fontSize=10;shape=mxgraph.cisco19.ip_phone2;fillColor=#FAFAFA;strokeColor=#8A9BA8;" vertex="1" parent="1"><mxGeometry x="1305" y="910" width="42" height="42" as="geometry"/></mxCell><mxCell id="c66" value="Wi-Fi doméstico&lt;br&gt;(clientes en la&lt;br&gt;misma red)" style="verticalLabelPosition=bottom;sketch=0;html=1;verticalAlign=top;aspect=fixed;align=center;pointerEvents=1;fontSize=10;shape=mxgraph.cisco19.wireless_access_point2;fillColor=#FAFAFA;strokeColor=#8A9BA8;" vertex="1" parent="1"><mxGeometry x="1480" y="905" width="46" height="32.199999999999996" as="geometry"/></mxCell><mxCell id="c67" value="PC de todos los&lt;br&gt;departamentos&lt;br&gt;(red plana)" style="verticalLabelPosition=bottom;sketch=0;html=1;verticalAlign=top;aspect=fixed;align=center;pointerEvents=1;fontSize=10;shape=mxgraph.cisco19.workstation2;fillColor=#FAFAFA;strokeColor=#8A9BA8;" vertex="1" parent="1"><mxGeometry x="1670" y="905" width="46" height="36.800000000000004" as="geometry"/></mxCell><mxCell id="c68" value="Impresora" style="verticalLabelPosition=bottom;sketch=0;html=1;verticalAlign=top;aspect=fixed;align=center;pointerEvents=1;fontSize=10;shape=mxgraph.cisco19.printer2;fillColor=#FAFAFA;strokeColor=#8A9BA8;" vertex="1" parent="1"><mxGeometry x="1860" y="905" width="46" height="36.800000000000004" as="geometry"/></mxCell><mxCell id="c69" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B0BEC5;strokeWidth=1.5;" edge="1" parent="1" source="c59" target="c66"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c70" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B0BEC5;strokeWidth=1.5;" edge="1" parent="1" source="c60" target="c67"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c71" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B0BEC5;strokeWidth=1.5;" edge="1" parent="1" source="c61" target="c68"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c72" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#78909C;" edge="1" parent="1" source="c58" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c73" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B0BEC5;dashed=1;" edge="1" parent="1" source="c65" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c74" value="&lt;b&gt;Problemas detectados&lt;/b&gt;&lt;br&gt;✖ Sedes aisladas: sin enlace privado entre ellas; los datos se comparten por correo&lt;br&gt;✖ Punto único de falla: switches en cascada sin enlaces redundantes (sin alta disponibilidad capa 2)&lt;br&gt;✖ Red plana sin VLAN: todos los departamentos y visitantes en el mismo dominio de broadcast&lt;br&gt;✖ Telefonía analógica por sede: alto costo, sin IVR ni central unificada&lt;br&gt;✖ Equipos domésticos de distintas marcas: sin gestión, sin QoS, sin soporte&lt;br&gt;✖ Sin monitoreo ni registro de eventos de seguridad&lt;br&gt;✖ Sin servicios en la nube (web, DNS, FTP) y riego manual sin datos" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#C62828;fillColor=#FFEBEE;strokeColor=#E57373;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="1050" width="1180" height="190" as="geometry"/></mxCell><mxCell id="c75" value="&lt;b&gt;Requerimientos del cliente que motivan el proyecto:&lt;/b&gt; reducir costos de telefonía, comunicación con clientes (IVR), alta disponibilidad, equipamiento Cisco, servicios virtualizados en la nube y automatización del riego con IoT." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1A237E;fillColor=#E8EAF6;strokeColor=#7986CB;spacing=4;" vertex="1" parent="1"><mxGeometry x="1220" y="1050" width="760" height="120" as="geometry"/></mxCell><mxCell id="c76" value="Nota: el enunciado no entrega la red existente en detalle; este AS-IS es una deducción razonable a partir de las necesidades descritas por la empresa." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#757575;fillColor=none;strokeColor=none;spacing=4;" vertex="1" parent="1"><mxGeometry x="1220" y="1180" width="760" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 - Red propuesta (TO-BE)" id="2_-_Red_"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1250" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Agroprodel Ltda. — Red propuesta e implementada (TO-BE) · Modelo de Arquitectura Empresarial Cisco" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#0D47A1;fillColor=none;strokeColor=none;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Red convergente datos + voz · 4 sedes · Alta disponibilidad capa 2 (Rapid-PVST+ / 802.1w) · EtherChannel LACP · GRE sobre IPsec AES-256 · Servicios y SOC virtualizados en AWS" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#455A64;fillColor=none;strokeColor=none;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1900" height="22" as="geometry"/></mxCell><mxCell id="c4" value="ENTERPRISE CAMPUS — Casa matriz Temuco · 192.168.40.0/23 (reserva 192.168.41.0/24)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="820" height="1030" as="geometry"/></mxCell><mxCell id="c5" value="Distribución / núcleo colapsado" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#90CAF9;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#90CAF9;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="780" height="150" as="geometry"/></mxCell><mxCell id="c6" value="Acceso (Building Access)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#90CAF9;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#90CAF9;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="295" width="780" height="145" as="geometry"/></mxCell><mxCell id="c7" value="Usuarios y dispositivos finales" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#90CAF9;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#90CAF9;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="455" width="780" height="205" as="geometry"/></mxCell><mxCell id="c8" value="Sala de servidores — Server Farm (VLAN 80 · 192.168.40.224/28)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#90CAF9;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#90CAF9;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="675" width="780" height="250" as="geometry"/></mxCell><mxCell id="c9" value="DIST-TEMUCO&lt;br&gt;&lt;span style='font-weight:normal'&gt;Raíz Rapid-PVST+&lt;/span&gt;" style="sketch=0;points=[[0.015,0.015,0],[0.985,0.015,0],[0.985,0.985,0],[0.015,0.985,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];verticalLabelPosition=bottom;html=1;verticalAlign=top;aspect=fixed;align=center;pointerEvents=1;shape=mxgraph.cisco19.rect;fillColo