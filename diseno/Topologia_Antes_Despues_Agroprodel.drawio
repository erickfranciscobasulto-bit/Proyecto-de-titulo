rtos de acceso (28 libres para crecer) · QoS voz DSCP EF + LLQ · RA Guard, BPDU Guard, PortFast" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#37474F;fillColor=none;strokeColor=none;spacing=4;" vertex="1" parent="1"><mxGeometry x="55" y="605" width="760" height="50" as="geometry"/></mxCell><mxCell id="c32" value="Switch de distribución · VLAN 80 Servidores (gateway 192.168.40.225)" style="rounded=1;html=1;fillColor=#1565C0;strokeColor=none;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="712" width="740" height="18" as="geometry"/></mxCell><mxCell id="c33" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1565C0;strokeWidth=2.5;" edge="1" parent="1" source="c9" target="c32"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="185"/><mxPoint x="30" y="721"/></Array></mxGeometry></mxCell><mxCell id="c34" value="PVE-01&lt;br&gt;&lt;span style='font-weight:normal'&gt;HPE DL20 Gen11&lt;/span&gt;" style="verticalLabelPosition=bottom;sketch=0;html=1;verticalAlign=top;aspect=fixed;align=center;pointerEvents=1;fontSize=10;shape=mxgraph.cisco19.server2;fillColor=#FAFAFA;strokeColor=#005073;" vertex="1" parent="1"><mxGeometry x="85" y="760" width="34.1" height="62" as="geometry"/></mxCell><mxCell id="c35" value="PVE-02&lt;br&gt;&lt;span style='font-weight:normal'&gt;HPE DL20 Gen11&lt;/span&gt;" style="verticalLabelPosition=bottom;sketch=0;html=1;verticalAlign=top;aspect=fixed;align=center;pointerEvents=1;fontSize=10;shape=mxgraph.cisco19.server2;fillColor=#FAFAFA;strokeColor=#005073;" vertex="1" parent="1"><mxGeometry x="185" y="760" width="34.1" height="62" as="geometry"/></mxCell><mxCell id="c36" value="NAS-RESPALDO&lt;br&gt;&lt;span style='font-weight:normal'&gt;Synology RS422+&lt;/span&gt;" style="sketch=0;points=[[0.015,0.015,0],[0.985,0.015,0],[0.985,0.985,0],[0.015,0.985,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];verticalLabelPosition=bottom;html=1;verticalAlign=top;aspect=fixed;align=center;pointerEvents=1;shape=mxgraph.cisco19.rect;fillColor=#FAFAFA;fontSize=11;fontStyle=1;prIcon=storage;strokeColor=#005073;" vertex="1" parent="1"><mxGeometry x="615" y="755" width="55" height="55" as="geometry"/></mxCell><mxCell id="c37" value="UPS 1500 VA&lt;br&gt;&lt;span style='font-weight:normal'&gt;x3 (rack)&lt;/span&gt;" style="sketch=0;points=[[0.015,0.015,0],[0.985,0.015,0],[0.985,0.985,0],[0.015,0.985,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];verticalLabelPosition=bottom;html=1;verticalAlign=top;aspect=fixed;align=center;pointerEvents=1;shape=mxgraph.cisco19.rect;fillColor=#FAFAFA;fontSize=11;fontStyle=1;prIcon=ups;strokeColor=#005073;" vertex="1" parent="1"><mxGeometry x="730" y="755" width="55" height="55" as="geometry"/></mxCell><mxCell id="c38" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1565C0;strokeWidth=1.5;" edge="1" parent="1" source="c32" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1565C0;strokeWidth=1.5;" edge="1" parent="1" source="c32" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1565C0;strokeWidth=1.5;" edge="1" parent="1" source="c32" target="c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="clúster" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="c34" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="&lt;b&gt;Clúster Proxmox VE (alta disponibilidad de VM)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;DC01&lt;/b&gt; Active Directory · DNS interno · GPO&lt;br&gt;• &lt;b&gt;DC02&lt;/b&gt; controlador de dominio réplica&lt;br&gt;• &lt;b&gt;SRV-ISSABEL&lt;/b&gt; central IP · 192.168.40.226 · IVR 1-4&lt;br&gt;• &lt;b&gt;SRV-ARCHIVOS&lt;/b&gt; carpetas por departamento (permisos AD)&lt;br&gt;• &lt;b&gt;SRV-IMPRESION&lt;/b&gt; cola de impresión y escaneo&lt;br&gt;Si un nodo falla, sus VM se reinician en el otro." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9.5;fontColor=#263238;fillColor=#F5F9FF;strokeColor=#90CAF9;spacing=4;" vertex="1" parent="1"><mxGeometry x="268" y="740" width="305" height="180" as="geometry"/></mxCell><mxCell id="c43" value="Respaldo diario de VM y archivos (Active Backup), copia en Talca. UPS para servidores, NAS, firewall y router." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#37474F;fillColor=none;strokeColor=none;spacing=4;" vertex="1" parent="1"><mxGeometry x="598" y="845" width="220" height="75" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;VLAN por sede&lt;/b&gt;&lt;br&gt;10 Siembra y riego · 20 Cosecha y molienda · 30 Envasado y bodega · 40 Ventas · 50 Voz · 60 Invitados (solo Internet) · 70 IoT riego · 80 Servidores · 99 Gestión · 999 Nativa&lt;br&gt;&lt;b&gt;DHCP:&lt;/b&gt; en cada router (subinterfaces 802.1Q) · &lt;b&gt;DNS:&lt;/b&gt; AD interno + reenvío · &lt;b&gt;Doble pila&lt;/b&gt; IPv4/IPv6" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9.5;fontColor=#263238;fillColor=#FFFFFF;strokeColor=#90CAF9;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="935" width="385" height="165" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;Modelo jerárquico Cisco&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Acceso:&lt;/b&gt; usuarios, teléfonos, AP e IoT; seguridad de puerto y QoS.&lt;br&gt;• &lt;b&gt;Distribución / núcleo colapsado:&lt;/b&gt; agrega el acceso con EtherChannel y es raíz de Rapid-PVST+; en una sede de este tamaño núcleo y distribución se unen sin perder escalabilidad.&lt;br&gt;• Si cae un enlace, STP converge en ~1-2 s; si cae un cable de un EtherChannel, el canal sigue arriba." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9.5;fontColor=#263238;fillColor=none;strokeColor=none;spacing=4;" vertex="1" parent="1"><mxGeometry x="435" y="935" width="395" height="170" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b style='font-size:13px'&gt;Direccionamiento Temuco (VLSM sobre 192.168.40.0/24 · reserva 192.168.41.0/24)&lt;/b&gt;&lt;table border='1' cellpadding='4' style='border-collapse:collapse;margin-top:6px;width:100%'&gt;&lt;tr style='background:#E3F2FD'&gt;&lt;th&gt;VLAN&lt;/th&gt;&lt;th&gt;Nombre&lt;/th&gt;&lt;th&gt;Red&lt;/th&gt;&lt;th&gt;Gateway (R-TEMUCO)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;10&lt;/td&gt;&lt;td&gt;Siembra y riego&lt;/td&gt;&lt;td&gt;192.168.40.128/27&lt;/td&gt;&lt;td&gt;.129&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;20&lt;/td&gt;&lt;td&gt;Cosecha y molienda&lt;/td&gt;&lt;td&gt;192.168.40.0/26&lt;/td&gt;&lt;td&gt;.1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;30&lt;/td&gt;&lt;td&gt;Envasado y bodega&lt;/td&gt;&lt;td&gt;192.168.40.64/26&lt;/td&gt;&lt;td&gt;.65&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;40&lt;/td&gt;&lt;td&gt;Ventas&lt;/td&gt;&lt;td&gt;192.168.40.160/28&lt;/td&gt;&lt;td&gt;.161&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;50&lt;/td&gt;&lt;td&gt;Voz&lt;/td&gt;&lt;td&gt;192.168.40.176/28&lt;/td&gt;&lt;td&gt;.177&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;60&lt;/td&gt;&lt;td&gt;Invitados (solo Internet)&lt;/td&gt;&lt;td&gt;192.168.40.192/28&lt;/td&gt;&lt;td&gt;.193&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;70&lt;/td&gt;&lt;td&gt;IoT riego&lt;/td&gt;&lt;td&gt;192.168.40.208/28&lt;/td&gt;&lt;td&gt;.209&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;80&lt;/td&gt;&lt;td&gt;Servidores&lt;/td&gt;&lt;td&gt;192.168.40.224/28&lt;/td&gt;&lt;td&gt;.225&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;99&lt;/td&gt;&lt;td&gt;Gestión&lt;/td&gt;&lt;td&gt;192.168.40.240/28&lt;/td&gt;&lt;td&gt;.241&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#263238;fillColor=none;strokeColor=none;spacing=4;" vertex="1" parent="1"><mxGeometry x="870" y="90" width="1100" height="330" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b style='font-size:13px'&gt;Capacidad de acceso&lt;/b&gt;&lt;br&gt;ACC1 48 PoE+ · ACC2 48 PoE+ · ACC3 24 PoE+ = 120 puertos para 92 equipos (88 usuarios + AP, IoT y 2 impresoras): 28 libres (30 %).&lt;br&gt;El PC se conecta detrás del teléfono IP: un solo punto de red por puesto.&lt;br&gt;&lt;br&gt;&lt;b style='font-size:13px'&gt;Seguridad en el acceso&lt;/b&gt;&lt;br&gt;PortFast + BPDU Guard · RA Guard (IPv6) · VLAN nativa 999 sin uso · puertos libres apagados en VLAN de cuarentena · ACL entre VLAN en el router.&lt;br&gt;&lt;br&gt;&lt;b style='font-size:13px'&gt;Calidad de servicio&lt;/b&gt;&lt;br&gt;Voz marcada DSCP EF y cola de prioridad (LLQ) en el router; la marca se conserva dentro de los túneles." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#263238;fillColor=#FFFFFF;strokeColor=#B0BEC5;spacing=4;" vertex="1" parent="1"><mxGeometry x="870" y="440" width="1100" height="330" as="geometry"/></mxCell><mxCell id="c48" value="Leyenda" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="20" y="1125" width="1960" height="72" as="geometry"/></mxCell><mxCell id="c49" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="1165" width="1" height="1" as="geometry"/></mxCell><mxCell id="c50" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="100" y="1165" width="1" height="1" as="geometry"/></mxCell><mxCell id="c51" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;shape=link;width=4;strokeColor=#2E7D32;" edge="1" parent="1" source="c49" target="c50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c52" value="EtherChannel LACP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#212121;fillColor=none;strokeColor=none;spacing=4;" vertex="1" parent="1"><mxGeometry x="110" y="1155" width="400" height="22" as="geometry"/></mxCell><mxCell id="c53" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="530" y="1165" width="1" height="1" as="geometry"/></mxCell><mxCell id="c54" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="590" y="1165" width="1" height="1" as="geometry"/></mxCell><mxCell id="c55" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#005073;strokeWidth=2;" edge="1" parent="1" source="c53" target="c54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c56" value="Troncal 802.1Q" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#212121;fillColor=none;strokeColor=none;spacing=4;" vertex="1" parent="1"><mxGeometry x="600" y="1155" width="400" height="22" as="geometry"/></mxCell><mxCell id="c57" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1020" y="1165" width="1" height="1" as="geometry"/></mxCell><mxCell id="c58" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1080" y="1165" width="1" height="1" as="geometry"/></mxCell><mxCell id="c59" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9E9E9E;dashed=1;strokeWidth=1.5;" edge="1" parent="1" source="c57" target="c58"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c60" value="Enlace redundante bloqueado por STP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#212121;fillColor=none;strokeColor=none;spacing=4;" vertex="1" parent="1"><mxGeometry x="1090" y="1155" width="400" height="22" as="geometry"/></mxCell><mxCell id="c61" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1510" y="1165" width="1" height="1" as="geometry"/></mxCell><mxCell id="c62" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1570" y="1165" width="1" height="1" as="geometry"/></mxCell><mxCell id="c63" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1565C0;strokeWidth=2.5;" edge="1" parent="1" source="c61" target="c62"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c64" value="VLAN 80 servidores" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#212121;fillColor=none;strokeColor=none;spacing=4;" vertex="1" parent="1"><mxGeometry x="1580" y="1155" width="400" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="5 - LAN sucursales" id="5_-_LAN_"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1250" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="LAN de sucursales — mismo diseño en las 3 sedes" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#0D47A1;fillColor=none;strokeColor=none;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Router con subinterfaces 802.1Q (DHCP y gateway) · distribución + 2 accesos con EtherChannel LACP · el tamaño de los switches de acceso