unded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#78909C;strokeWidth=1.5;" edge="1" parent="1" source="c10" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#78909C;strokeWidth=1.5;" edge="1" parent="1" source="c10" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#78909C;strokeWidth=1.5;" edge="1" parent="1" source="c11" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#78909C;strokeWidth=1.5;" edge="1" parent="1" source="c11" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#78909C;strokeWidth=1.5;" edge="1" parent="1" source="c12" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#78909C;strokeWidth=1.5;" edge="1" parent="1" source="c12" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="&lt;b&gt;Dotación Temuco:&lt;/b&gt; 88 usuarios (Siembra 20 · Cosecha 26 · Envasado 32 · Ventas 10) · 10 teléfonos IP · 120 puertos de acceso (28 libres para crecer) · QoS voz DSCP EF + LLQ · RA Guard, BPDU Guard, PortFast" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#37474F;fillColor=none;strokeColor=none;spacing=4;" vertex="1" parent="1"><mxGeometry x="55" y="605" width="760" height="50" as="geometry"/></mxCell><mxCell id="c32" value="Switch de distribución · VLAN 80 Servidores (gateway 192.168.40.225)" style="rounded=1;html=1;fillColor=#1565C0;strokeColor=none;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="712" width="740" height="18" as="geometry"/></mxCell><mxCell id="c33" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1565C0;strokeWidth=2.5;" edge="1" parent="1" source="c9" target="c32"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="185"/><mxPoint x="30" y="721"/></Array></mxGeometry></mxCell><mxCell id="c34" value="PVE-01&lt;br&gt;&lt;span style='font-weight:normal'&gt;HPE DL20 Gen11&lt;/span&gt;" style="verticalLabelPosition=bottom;sketch=0;html=1;verticalAlign=top;aspect=fixed;align=center;pointerEvents=1;fontSize=10;shape=mxgraph.cisco19.server2;fillColor=#FAFAFA;strokeColor=#005073;" vertex="1" parent="1"><mxGeometry x="85" y="760" width="34.1" height="62" as="geometry"/></mxCell><mxCell id="c35" value="PVE-02&lt;br&gt;&lt;span style='font-weight:normal'&gt;HPE DL20 Gen11&lt;/span&gt;" style="verticalLabelPosition=bottom;sketch=0;html=1;verticalAlign=top;aspect=fixed;align=center;pointerEvents=1;fontSize=10;shape=mxgraph.cisco19.server2;fillColor=#FAFAFA;strokeColor=#005073;" vertex="1" parent="1"><mxGeometry x="185" y="760" width="34.1" height="62" as="geometry"/></mxCell><mxCell id="c36" value="NAS-RESPALDO&lt;br&gt;&lt;span style='font-weight:normal'&gt;Synology RS422+&lt;/span&gt;" style="sketch=0;points=[[0.015,0.015,0],[0.985,0.015,0],[0.985,0.985,0],[0.015,0.985,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];verticalLabelPosition=bottom;html=1;verticalAlign=top;aspect=fixed;align=center;pointerEvents=1;shape=mxgraph.cisco19.rect;fillColor=#FAFAFA;fontSize=11;fontStyle=1;prIcon=storage;strokeColor=#005073;" vertex="1" parent="1"><mxGeometry x="610" y="755" width="55" height="55" as="geometry"/></mxCell><mxCell id="c37" value="UPS 1500 VA&lt;br&gt;&lt;span style='font-weight:normal'&gt;x3 (rack)&lt;/span&gt;" style="sketch=0;points=[[0.015,0.015,0],[0.985,0.015,0],[0.985,0.985,0],[0.015,0.985,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];verticalLabelPosition=bottom;html=1;verticalAlign=top;aspect=fixed;align=center;pointerEvents=1;shape=mxgraph.cisco19.rect;fillColor=#FAFAFA;fontSize=11;fontStyle=1;prIcon=ups;strokeColor=#005073;" vertex="1" parent="1"><mxGeometry x="720" y="755" width="55" height="55" as="geometry"/></mxCell><mxCell id="c38" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1565C0;strokeWidth=1.5;" edge="1" parent="1" source="c32" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1565C0;strokeWidth=1.5;" edge="1" parent="1" source="c32" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1565C0;strokeWidth=1.5;" edge="1" parent="1" source="c32" target="c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="clúster" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="c34" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="&lt;b&gt;Clúster Proxmox VE (alta disponibilidad de VM)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;DC01&lt;/b&gt; Active Directory · DNS interno · GPO&lt;br&gt;• &lt;b&gt;DC02&lt;/b&gt; controlador de dominio réplica&lt;br&gt;• &lt;b&gt;SRV-ISSABEL&lt;/b&gt; central IP · 192.168.40.226 · IVR 1-4&lt;br&gt;• &lt;b&gt;SRV-ARCHIVOS&lt;/b&gt; carpetas por departamento (permisos AD)&lt;br&gt;• &lt;b&gt;SRV-IMPRESION&lt;/b&gt; cola de impresión y escaneo&lt;br&gt;Si un nodo falla, sus VM se reinician en el otro." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9.5;fontColor=#263238;fillColor=#F5F9FF;strokeColor=#90CAF9;spacing=4;" vertex="1" parent="1"><mxGeometry x="275" y="740" width="320" height="180" as="geometry"/></mxCell><mxCell id="c43" value="Respaldo diario de VM y archivos (Active Backup), copia en Talca. UPS para servidores, NAS, firewall y router." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#37474F;fillColor=none;strokeColor=none;spacing=4;" vertex="1" parent="1"><mxGeometry x="600" y="840" width="215" height="80" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;VLAN por sede&lt;/b&gt;&lt;br&gt;10 Siembra y riego · 20 Cosecha y molienda · 30 Envasado y bodega · 40 Ventas · 50 Voz · 60 Invitados (solo Internet) · 70 IoT riego · 80 Servidores · 99 Gestión · 999 Nativa&lt;br&gt;&lt;b&gt;DHCP:&lt;/b&gt; en cada router (subinterfaces 802.1Q) · &lt;b&gt;DNS:&lt;/b&gt; AD interno + reenvío · &lt;b&gt;Doble pila&lt;/b&gt; IPv4/IPv6" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9.5;fontColor=#263238;fillColor=#FFFFFF;strokeColor=#90CAF9;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="935" width="385" height="165" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;Modelo jerárquico Cisco&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Acceso:&lt;/b&gt; usuarios, teléfonos, AP e IoT; seguridad de puerto y QoS.&lt;br&gt;• &lt;b&gt;Distribución / núcleo colapsado:&lt;/b&gt; agrega el acceso con EtherChannel y es raíz de Rapid-PVST+; en una sede de este tamaño núcleo y distribución se unen sin perder escalabilidad.&lt;br&gt;• Si cae un enlace, STP converge en ~1-2 s; si cae un cable de un EtherChannel, el canal sigue arriba." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9.5;fontColor=#263238;fillColor=none;strokeColor=none;spacing=4;" vertex="1" parent="1"><mxGeometry x="435" y="935" width="395" height="170" as="geometry"/></mxCell><mxCell id="c46" value="ENTERPRISE EDGE" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="870" y="80" width="310" height="500" as="geometry"/></mxCell><mxCell id="c47" value="R-TEMUCO&lt;br&gt;&lt;span style='font-weight:normal'&gt;PAT · hub GRE/IPsec&lt;br&gt;VPN a AWS · OSPF&lt;/span&gt;" style="sketch=0;points=[[0.5,0,0],[1,0.5,0],[0.5,1,0],[0,0.5,0],[0.145,0.145,0],[0.8555,0.145,0],[0.855,0.8555,0],[0.145,0.855,0]];verticalLabelPosition=bottom;html=1;verticalAlign=top;aspect=fixed;align=center;pointerEvents=1;shape=mxgraph.cisco19.rect;fillColor=#FAFAFA;perimeter=ellipsePerimeter;fontSize=11;fontStyle=1;prIcon=router;strokeColor=#005073;" vertex="1" parent="1"><mxGeometry x="905" y="160" width="50" height="50" as="geometry"/></mxCell><mxCell id="c48" value="FW-TEMUCO&lt;br&gt;&lt;span style='font-weight:normal'&gt;OPNsense&lt;br&gt;IDS Suricata&lt;/span&gt;" style="sketch=0;points=[[0.015,0.015,0],[0.985,0.015,0],[0.985,0.985,0],[0.015,0.985,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];verticalLabelPosition=bottom;html=1;verticalAlign=top;aspect=fixed;align=center;pointerEvents=1;shape=mxgraph.cisco19.rect;fillColor=#FAFAFA;fontSize=11;fontStyle=1;prIcon=firewall;strokeColor=#005073;" vertex="1" parent="1"><mxGeometry x="1085" y="160" width="50" height="50" as="geometry"/></mxCell><mxCell id="c49" value="Troncal 802.1Q" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#005073;" edge="1" parent="1" source="c9" target="c47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c50" value="203.0.113.0/30" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#5D4037;" edge="1" parent="1" source="c47" target="c48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c51" value="&lt;b&gt;Funciones del borde&lt;/b&gt;&lt;br&gt;• PAT: los equipos internos salen con la IP pública de la sede.&lt;br&gt;• Hub de túneles GRE cifrados con IPsec (AES-256) hacia las 3 sucursales.&lt;br&gt;• Enrutamiento dinámico OSPF entre sedes por los túneles.&lt;br&gt;• VPN IKEv2 hacia la nube (gestión SNMPv3, syslog, Zabbix).&lt;br&gt;• Firewall perimetral + IDS Suricata (alertas a Wazuh).&lt;br&gt;• ACL entre VLAN: invitados e IoT solo Internet." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#4E342E;fillColor=none;strokeColor=none;spacing=4;" vertex="1" parent="1"><mxGeometry x="885" y="300" width="285" height="270" as="geometry"/></mxCell><mxCell id="c52" value="SERVICE PROVIDER EDGE" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#6A1B9A;" vertex="1" parent="1"><mxGeometry x="1210" y="80" width="290" height="500" as="geometry"/></mxCell><mxCell id="c53" value="Internet / ISP&lt;br&gt;&lt;span style='font-weight:normal'&gt;IP pública por sede&lt;/span&gt;" style="verticalLabelPosition=bottom;sketch=0;html=1;verticalAlign=top;aspect=fixed;align=center;pointerEvents=1;fontSize=10;shape=mxgraph.cisco19.cloud2;fillColor=#FFE9AA;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1285" y="165" width="136.0" height="85" as="geometry"/></mxCell><mxCell id="c54" value="WAN 203.0.113.18/30" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#5D4037;" edge="1" parent="1" source="c48" target="c53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c55" value="&lt;b&gt;Enlaces a Internet independientes&lt;/b&gt;&lt;br&gt;Temuco 203.0.113.18 (vía firewall)&lt;br&gt;Talca 203.0.113.6&lt;br&gt;Concepción 203.0.113.10&lt;br&gt;Los Ángeles 203.0.113.14&lt;br&gt;&lt;br&gt;Cada sede navega por su propio enlace; el tráfico entre sedes viaja dentro de los túneles cifrados." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#4A148C;fillColor=none;strokeColor=none;spacing=4;" vertex="1" parent="1"><mxGeometry x="1225" y="320" width="265" height="250" as="geometry"/></mxCell><mxCell id="c56" value="ENTERPRISE DATA CENTER — Nube AWS (VPC 10.40.0.0/16)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="1530" y="80" width="450" height="500" as="geometry"/></mxCell><mxCell id="c57" value="SRV-AGROPRODEL&lt;br&gt;&lt;span style='font-weight:normal'&gt;Web HTTPS · DNS · FTPS&lt;br&gt;10.40.1.10&lt;/span&gt;" style="verticalLabelPosition=bottom;sketch=0;html=1;verticalAlign=top;aspect=fixed;align=center;pointerEvents=1;fontSize=10;shape=mxgraph.cisco19.dns_server2;fillColor=#FAFAFA;strokeColor=#005073;" vertex="1" parent="1"><mxGeometry x="1570" y="140" width="33.0" height="60" as="geometry"/></mxCell><mxCell id="c58" value="SRV-NOC&lt;br&gt;&lt;span style='font-weight:normal'&gt;Zabbix · Grafana&lt;br&gt;strongSwan · 10.40.1.30&lt;/span&gt;" style="verticalLabelPosition=bottom;sketch=0;html=1;verticalAlign=top;aspect=fixed;align=center;pointerEvents=1;fontSize=10;shape=mxgraph.cisco19.server2;fillColor=#FAFAFA;strokeColor=#005073;" vertex="1" parent="1"><mxGeometry x="1730" y="140" width="33.0" height="60" as="geometry"/></mxCell><mxCell id="c59" value="SRV-SIEM&lt;br&gt;&