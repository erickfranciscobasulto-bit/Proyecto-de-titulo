etry></mxCell><mxCell id="c111" value="Túnel GRE sobre IPsec AES-256" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#212121;fillColor=none;strokeColor=none;spacing=4;" vertex="1" parent="1"><mxGeometry x="1580" y="1035" width="400" height="22" as="geometry"/></mxCell><mxCell id="c112" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="1077" width="1" height="1" as="geometry"/></mxCell><mxCell id="c113" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="100" y="1077" width="1" height="1" as="geometry"/></mxCell><mxCell id="c114" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 4;strokeColor=#6A1B9A;strokeWidth=2.5;" edge="1" parent="1" source="c112" target="c113"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c115" value="VPN IPsec IKEv2 matriz ↔ AWS" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#212121;fillColor=none;strokeColor=none;spacing=4;" vertex="1" parent="1"><mxGeometry x="110" y="1067" width="400" height="22" as="geometry"/></mxCell><mxCell id="c116" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="530" y="1077" width="1" height="1" as="geometry"/></mxCell><mxCell id="c117" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="590" y="1077" width="1" height="1" as="geometry"/></mxCell><mxCell id="c118" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9E9E9E;dashed=1;strokeWidth=1.5;" edge="1" parent="1" source="c116" target="c117"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c119" value="Enlace redundante bloqueado por STP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#212121;fillColor=none;strokeColor=none;spacing=4;" vertex="1" parent="1"><mxGeometry x="600" y="1067" width="400" height="22" as="geometry"/></mxCell><mxCell id="c120" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1020" y="1077" width="1" height="1" as="geometry"/></mxCell><mxCell id="c121" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1080" y="1077" width="1" height="1" as="geometry"/></mxCell><mxCell id="c122" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=2 3;strokeColor=#00897B;strokeWidth=2.5;" edge="1" parent="1" source="c120" target="c121"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c123" value="Troncal SIP / respaldo PSTN" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#212121;fillColor=none;strokeColor=none;spacing=4;" vertex="1" parent="1"><mxGeometry x="1090" y="1067" width="400" height="22" as="geometry"/></mxCell><mxCell id="c124" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1510" y="1077" width="1" height="1" as="geometry"/></mxCell><mxCell id="c125" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1570" y="1077" width="1" height="1" as="geometry"/></mxCell><mxCell id="c126" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#F9A825;strokeWidth=8;opacity=60;" edge="1" parent="1" source="c124" target="c125"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c127" value="Router OSPF área 0 (halo)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#212121;fillColor=none;strokeColor=none;spacing=4;" vertex="1" parent="1"><mxGeometry x="1580" y="1067" width="400" height="22" as="geometry"/></mxCell><mxCell id="c128" value="Cada sucursal: 10 teléfonos IP · PC por departamento · AP de invitados (VLAN 60, solo Internet) · ESP32 de riego (VLAN 70) · ATA con línea analógica de emergencia. Doble pila IPv4/IPv6 en todas las sedes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontColor=#5D4037;fillColor=#FFFDE7;strokeColor=#F9A825;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="1109" width="1920" height="48" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 - Enrutamiento OSPF (capa 3)" id="3_-_Enru"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1150" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Enrutamiento entre sedes — OSPF sobre túneles GRE/IPsec (topología hub-and-spoke)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#0D47A1;fillColor=none;strokeColor=none;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Los túneles GRE transportan OSPF (multicast) y IPsec cifra todo el tráfico; Internet es solo el transporte (underlay)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#455A64;fillColor=none;strokeColor=none;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1900" height="22" as="geometry"/></mxCell><mxCell id="c4" value="OSPF proceso 1 · ÁREA 0 (backbone)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;strokeWidth=3;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=16;fontStyle=1;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1340" height="860" as="geometry"/></mxCell><mxCell id="c5" value="R-TEMUCO (hub · ASBR)&lt;span style='font-weight:normal'&gt;&lt;br&gt;RID 1.1.1.1&lt;br&gt;LAN 192.168.40.0/24 (pasiva)&lt;/span&gt;" style="sketch=0;points=[[0.5,0,0],[1,0.5,0],[0.5,1,0],[0,0.5,0],[0.145,0.145,0],[0.8555,0.145,0],[0.855,0.8555,0],[0.145,0.855,0]];verticalLabelPosition=bottom;html=1;verticalAlign=top;aspect=fixed;align=center;pointerEvents=1;shape=mxgraph.cisco19.rect;fillColor=#FAFAFA;perimeter=ellipsePerimeter;fontSize=11;fontStyle=1;prIcon=router;strokeColor=#005073;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="678" y="190" width="64" height="64" as="geometry"/></mxCell><mxCell id="c6" value="Tunnel1 172.16.0.1 · Tunnel2 172.16.0.5 · Tunnel3 172.16.0.9&lt;br&gt;origen de todos: WAN de Temuco" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="120" width="320" height="50" as="geometry"/></mxCell><mxCell id="c7" value="R-TALCA&lt;span style='font-weight:normal'&gt;&lt;br&gt;RID 2.2.2.2&lt;br&gt;LAN 192.168.10.0/24 (pasiva)&lt;/span&gt;" style="sketch=0;points=[[0.5,0,0],[1,0.5,0],[0.5,1,0],[0,0.5,0],[0.145,0.145,0],[0.8555,0.145,0],[0.855,0.8555,0],[0.145,0.855,0]];verticalLabelPosition=bottom;html=1;verticalAlign=top;aspect=fixed;align=center;pointerEvents=1;shape=mxgraph.cisco19.rect;fillColor=#FAFAFA;perimeter=ellipsePerimeter;fontSize=11;fontStyle=1;prIcon=router;strokeColor=#005073;" vertex="1" parent="1"><mxGeometry x="198" y="690" width="64" height="64" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Tunnel1 · 172.16.0.0/30&lt;/b&gt;&lt;br&gt;172.16.0.1 ↔ 172.16.0.2&lt;br&gt;GRE + IPsec AES-256" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1E88E5;strokeWidth=3.5;dashed=1;dashPattern=10 5;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="R-CONCEPCION&lt;span style='font-weight:normal'&gt;&lt;br&gt;RID 3.3.3.3&lt;br&gt;LAN 192.168.20.0/24 (pasiva)&lt;/span&gt;" style="sketch=0;points=[[0.5,0,0],[1,0.5,0],[0.5,1,0],[0,0.5,0],[0.145,0.145,0],[0.8555,0.145,0],[0.855,0.8555,0],[0.145,0.855,0]];verticalLabelPosition=bottom;html=1;verticalAlign=top;aspect=fixed;align=center;pointerEvents=1;shape=mxgraph.cisco19.rect;fillColor=#FAFAFA;perimeter=ellipsePerimeter;fontSize=11;fontStyle=1;prIcon=router;strokeColor=#005073;" vertex="1" parent="1"><mxGeometry x="678" y="690" width="64" height="64" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Tunnel2 · 172.16.0.4/30&lt;/b&gt;&lt;br&gt;172.16.0.5 ↔ 172.16.0.6&lt;br&gt;GRE + IPsec AES-256" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#43A047;strokeWidth=3.5;dashed=1;dashPattern=10 5;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="R-LOS-ANGELES&lt;span style='font-weight:normal'&gt;&lt;br&gt;RID 4.4.4.4&lt;br&gt;LAN 192.168.30.0/24 (pasiva)&lt;/span&gt;" style="sketch=0;points=[[0.5,0,0],[1,0.5,0],[0.5,1,0],[0,0.5,0],[0.145,0.145,0],[0.8555,0.145,0],[0.855,0.8555,0],[0.145,0.855,0]];verticalLabelPosition=bottom;html=1;verticalAlign=top;aspect=fixed;align=center;pointerEvents=1;shape=mxgraph.cisco19.rect;fillColor=#FAFAFA;perimeter=ellipsePerimeter;fontSize=11;fontStyle=1;prIcon=router;strokeColor=#005073;" vertex="1" parent="1"><mxGeometry x="1158" y="690" width="64" height="64" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Tunnel3 · 172.16.0.8/30&lt;/b&gt;&lt;br&gt;172.16.0.9 ↔ 172.16.0.10&lt;br&gt;GRE + IPsec AES-256" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#8E24AA;strokeWidth=3.5;dashed=1;dashPattern=10 5;" edge="1" parent="1" source="c5" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="&lt;b&gt;Base de datos OSPF (LSDB):&lt;/b&gt; 4 routers · 3 enlaces punto a punto (túneles) · 1 ruta externa (AWS).&lt;br&gt;&lt;b&gt;Interfaces LAN pasivas:&lt;/b&gt; se anuncian las redes, pero no se envían hellos hacia los usuarios (nadie puede inyectar rutas desde una VLAN).&lt;br&gt;&lt;b&gt;IPv6:&lt;/b&gt; OSPFv3 con la misma topología (doble pila)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3E2723;fillColor=none;strokeColor=none;spacing=4;" vertex="1" parent="1"><mxGeometry x="70" y="820" width="1290" height="115" as="geometry"/></mxCell><mxCell id="c14" value="Fuera del área: nube AWS" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="1420" y="90" width="540" height="300" as="geometry"/></mxCell><mxCell id="c15" value="SRV-NOC · VPC 10.40.0.0/16&lt;span style='font-weight:normal'&gt;&lt;br&gt;(Zabbix, Grafana, Wazuh, servicios)&lt;/span&gt;" style="verticalLabelPosition=bottom;sketch=0;html=1;verticalAlign=top;aspect=fixed;align=center;pointerEvents=1;fontSize=10;shape=mxgraph.cisco19.server2;fillColor=#FAFAFA;strokeColor=#005073;" vertex="1" parent="1"><mxGeometry x="1665" y="150" width="33.0" height="60" as="geometry"/></mxCell><mxCell id="c16" value="VPN IKEv2 + ruta estática 10.40.0.0/16" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 4;strokeColor=#6A1B9A;strokeWidth=2.5;" edge="1" parent="1" source="c5" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="222"/><mxPoint x="1100" y="180"/></Array></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;R-TEMUCO es ASBR:&lt;/b&gt; redistribuye la ruta estática de AWS en OSPF (&lt;i&gt;redistribute static subnets route-map RM-AWS&lt;/i&gt;) como externa E2; así las 3 sucursales llegan a la nube a través de Temuco sin configurar nada en ellas." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontColor=#1B5E20;fillColor=none;strokeColor=none;spacing=4;" vertex="1" parent="1"><mxGeometry x="1435" y="280" width="510" height="105" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;¿Por qué un área única?&lt;/b&gt;&lt;br&gt;Cisco recomienda dividir en áreas cuando la red crece (decenas de routers) para limitar el tamaño de la LSDB y el cálculo SPF. Con 4 routers, un área 0 es más simple, converge igual de rápido y evita ABR innecesarios.&lt;br&gt;&lt;br&gt;&lt;b&gt;¿Por qué hub-and-spoke?&lt;/b&gt;&lt;br&gt;La telefonía y los servidores están en Temuco: todo el tráfico entre sedes pasa por la matriz. 3 túneles en vez de 6 (malla completa) simplifican la operación.&lt;br&gt;&lt;br&gt;&lt;b&gt;¿Por qué GRE + IPsec?&lt;/b&gt;&lt;br&gt;IPsec solo no transporta multicast; GRE sí, y permite usar OSPF. IPsec cifra el túnel completo (AES-256).&lt;br&gt;&lt;br&gt;&lt;b&gt;Escalabilidad:&lt;/b&gt; Temuco se resume como 192.168.40.0/23 y una sucursal nueva solo agrega un túnel y una red /24 en el área 0." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#263238;fillColor=#FFFFFF;strokeColor=#B0BEC5;spacing=4;" vertex="1" parent="1"><mxGeometry x="1420" y="410" width="540" height="540" as="geometry"/></mxCell><mxCell id="c19" value="Leyenda" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="20" y="970" width="1960" height="72" as="geometry"/></mxCell><mxCell id="c20" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="1" height="1" as="geometry"/></mxCell><mxCell id="c21" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="100" y="1010" width="1" height="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 4;strokeColor=#E65100;strokeWidth=2;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="Túnel GRE sobre IPsec AES-256" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#212121;fillColor=none;strokeColor=none;spacing=4;" vertex="1" parent="1"><mxGeometry x="110" y="1000" width="400" height="22" as="geometry"/></mxCell><mxCell id="c24" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="530" y="1010" width="1" height="1" as="geometry"/></mxCell><mxCell id="c25" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="590" y="1010" width="1" height="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 4;strokeColor=#6A1B9A;strokeWidth=2.5;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="VPN IPsec IKEv2 matriz ↔ AWS" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#212121;fillColor=none;strokeColor=none;spacing=4;" vertex="1" parent="1"><mxGeometry x="600" y="1000" width="400" height="22" as="geometry"/></mxCell><mxCell id="c28" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1020" y="1010" width="1" height="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1080" y="1010" width="1" height="1" as="geometry"/></mxCell><mxCell id="c30" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#F9A825;strokeWidth=8;opacity=60;" edge="1" parent="1" source="c28" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="Router OSPF área 0 (halo)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#212121;fillColor=none;strokeColor=none;spacing=4;" vertex="1" parent="1"><mxGeometry x="1090" y="1000" width="400" height="22" as="geometry"/></mxCell><mxCell id="c32" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1510" y="1010" width="1" height="1" as="geometry"/></mxCell><mxCell id="c33" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1570" y="1010" width="1" height="1" as="geometry"/></mxCell><mxCell id="c34" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1E88E5;strokeWidth=3.5;dashed=1;" edge="1" parent="1" source="c32" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="Color por sucursal" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#212121;fillColor=none;strokeColor=none;spacing=4;" vertex="1" parent="1"><mxGeometry x="1580" y="1000" width="400" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4 - LAN casa matriz Temuco" id="4_-_LAN_"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1250" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="LAN casa matriz Temuco — capa 2, usuarios y sala de servidores" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#0D47A1;fillColor=none;strokeColor=none;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Distribución con núcleo colapsado · 3 switches de acceso · Rapid-PVST+ · EtherChannel LACP · QoS para voz" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#455A64;fillColor=none;strokeColor=none;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1900" height="22" as="geometry"/></mxCell><mxCell id="c4" value="ENTERPRISE CAM